# Credenciales de inicio (opcional, para producción)
# Formato JSON: [{"username":"admin","password":"tu_password","name":"Admin"}]
# AUTH_INIT_USERS=[{"username":"admin","password":"cambiar","name":"Admin"}]
# O puedes usar passwordHash ya generado con bcrypt:
# AUTH_INIT_USERS=[{"username":"admin","passwordHash":"$2b$10$...","name":"Admin"}]

# Seguridad de sesión
JWT_SECRET=define_un_secreto_largo_y_unico
JWT_EXPIRATION=8h
AUTH_COOKIE_NAME=nk_session
# Origenes permitidos para CORS (coma separada). En Vercel se anade solo https://VERCEL_URL.
ALLOWED_ORIGINS=https://tu-dominio.vercel.app,https://tu-dominio-personalizado.com

# API key opcional para que app móvil envíe tracking sin sesión web
# TRACKING_API_KEY=define_una_api_key

# Secreto para el cron de recordatorios por correo (GET /api/cron/recordatorios-email).
# En Vercel Cron, si defines CRON_SECRET, la plataforma envía Authorization: Bearer <CRON_SECRET>.
# CRON_SECRET=define_un_secreto_largo_para_cron
# Cron en vercel.json va en UTC; Lima (PE) es UTC-5. Ej.: 08:00 Lima = 13:00 UTC (schedule "0 13 * * *").

# SMTP para restablecer contraseña (envía a jamesrojasdiaz01@gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
# Opcional: remitente distinto (si tu proveedor lo permite)
# SMTP_FROM="Norse Kredit <tu_correo@gmail.com>"
ADMIN_EMAIL=jamesrojasdiaz01@gmail.com

# Twilio (recordatorios SMS)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE=
